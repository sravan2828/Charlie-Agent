# Copy to .env and fill in. Never commit .env.

# LLM (OpenAI-compatible; works with xAI by pointing BASE_URL at api.x.ai)
# Get an xAI key from https://console.x.ai/ — leave blank to use chat/telephony stubs only.
XAI_API_KEY=
LLM_BASE_URL=https://api.x.ai/v1
LLM_MODEL=grok-4.7
LLM_MAX_TOOL_ITERATIONS=6

# Twilio (https://www.twilio.com/console) — placeholders only
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+15555550100

# Public base URL Twilio can reach (use ngrok / cloudflare tunnel in local dev)
PUBLIC_BASE_URL=https://your-tunnel.example.com

# Optional: DuckDuckGo Instant Answer is used as a lightweight search backend.
# Set to "stub" to force the labelled stub responses (useful for demos / offline).
SEARCH_BACKEND=stub

# Comma-separated host allowlist for the http_request tool (empty = deny all)
HTTP_ALLOWLIST=example.com,api.github.com

# Per-caller memory directory
MEMORY_DIR=./data/memory

# --- LiveKit voice (web client now, SIP trunks later) ---
# LiveKit Cloud free tier, or a local server: livekit-server --dev
# https://cloud.livekit.io/  — never commit the real key or secret.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Must match the agent name dispatched by the token server and, later, SIP rules.
LIVEKIT_AGENT_NAME=charlie
LIVEKIT_TOKEN_TTL=1h
# Token server + static page. Keep it on localhost unless you add auth.
TOKEN_HOST=127.0.0.1
TOKEN_PORT=8787

# Grok Voice speech-to-speech (xAI realtime WebSocket via the LiveKit xAI plugin).
# grok-voice-latest currently aliases grok-voice-3.0. Voices: eve, ara, rex, sal, leo.
XAI_VOICE_MODEL=grok-voice-latest
XAI_VOICE=eve
# grok (default) uses XAI_API_KEY above. cascade swaps in STT+LLM+TTS through LiveKit Inference.
VOICE_STACK=grok
CASCADE_STT_MODEL=assemblyai/universal-3-6-pro
CASCADE_LLM_MODEL=google/gemma-4-31b-it
CASCADE_TTS_MODEL=fishaudio/s2.1-pro
CASCADE_TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a

# Tool policy (shared by text, Twilio, and voice). Comma-separated.
# Empty TOOL_ALLOWLIST falls back to web_search,http_request,remember.
TOOL_ALLOWLIST=web_search,http_request,remember
# read (block write tools) or readwrite. POST http_request still needs confirmation.
TOOL_MODE=readwrite
# Extra tool names that always require confirm_action before they run.
CONFIRM_TOOLS=
# Optional narrower allowlist used only when constructing the voice session.
# Empty means the voice worker uses TOOL_ALLOWLIST.
VOICE_TOOL_ALLOWLIST=
