{
  "name": "charlie-agent",
  "version": "0.1.0",
  "description": "Phone-first AI agent showcase inspired by Grok bots (Node.js)",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "charlie": "src/cli.js"
  },
  "scripts": {
    "start": "node src/cli.js serve",
    "cli": "node src/cli.js",
    "chat": "node src/cli.js chat",
    "serve": "node src/cli.js serve",
    "server": "node src/cli.js serve",
    "call": "node src/cli.js call",
    "token": "node src/cli.js token",
    "voice": "node src/livekit/agent.js dev",
    "voice:start": "node src/livekit/agent.js start",
    "test": "node --test tests/*.js"
