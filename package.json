  "dependencies": {
    "@livekit/agents": "1.9.5",
    "@livekit/agents-plugin-openai": "1.9.5",
    "@livekit/agents-plugin-xai": "1.9.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "livekit-server-sdk": "2.19.2",
    "twilio": "^5.3.5"
  }
}
